{
  "name": "funky-theme-vscode",
  "displayName": "Funky Theme",
  "description": "A modern, vibrant, and expressive dark color theme for Visual Studio Code, Cursor, and Antigravity. Crafted for React, TypeScript, and web development, with semantic syntax highlighting, vivid colors, and low eye strain.",
  "version": "3.1.0",
  "publisher": "MaxGB23",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#24212e",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "modern",
    "color theme",
    "dark",
    "dark theme",
    "darker",
    "italic",
    "bold",
    "high contrast",
    "syntax highlighting",
    "pastel",
    "vibrant",
    "neon",
    "purple",
    "pink",
    "cyan",
    "funky",
    "semantic highlighting",
    "eye strain",
    "react",
    "vue",
    "nextjs",
    "angular",
    "typescript",
    "javascript",
    "frontend",
    "vscode",
    "vs code theme",
    "antigravity theme",
    "cursor theme"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgb23/funky-theme"
  },
  "bugs": {
    "url": "https://github.com/maxgb23/funky-theme/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies",
    "verify:vsix": "node scripts/verify-vsix.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Funky Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark.json"
      },
      {
        "label": "Funky Darker",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-darker.json"
      },
      {
        "label": "Funky Dark Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark-italic.json"
      },
      {
        "label": "Funky Dark Mix",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark-mix.json"
      },
      {
        "label": "Funky High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/maxiano-high-contrast.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "json5": "^2.2.3"
  },
  "pnpm": {}
}