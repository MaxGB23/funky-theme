{
  "name": "funky-theme-vscode",
  "displayName": "Funky Theme",
  "description": "Un tema moderno y expresivo, enfocado en el contraste semántico y la ergonomía visual.",
  "version": "1.1.6",
  "publisher": "maxgb23",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#24212e",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "dark",
    "italic",
    "high-contrast",
    "maxiano",
    "funky",
    "color-theme",
    "purple",
    "pink",
    "cyan",
    "green",
    "pastel",
    "orange",
    "gray",
    "yellow",
    "blue"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgb23/funky-theme"
  },
  "bugs": {
    "url": "https://github.com/maxgb23/funky-theme/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies"
  },
  "contributes": {
    "themes": [
      {
        "label": "Funky Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark.json"
      },
      {
        "label": "Funky Dark Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark-italic.json"
      },
      {
        "label": "Funky Darker",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-darker.json"
      },
      {
        "label": "Funky High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/maxiano-high-contrast.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "json5": "^2.2.3"
  },
  "pnpm": {}
}