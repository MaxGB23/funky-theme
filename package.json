{
  "name": "funky-theme-vscode",
  "displayName": "Funky Theme",
  "description": "A vibrant, expressive dark theme crafted for React, TypeScript and the web, with semantic contrast and low eye strain. Un tema moderno y expresivo para React, TypeScript y la web, con contraste semántico y ergonomía visual.",
  "version": "3.0.1",
  "publisher": "MaxGB23",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#24212e",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "dark-theme",
    "bold",
    "darker",
    "mix",
    "italic",
    "high-contrast",
    "syntax",
    "highlighting",
    "pastel",
    "vibrant",
    "vscode",
    "purple",
    "pink",
    "lavender",
    "funky",
    "semantic",
    "eye-strain",
    "react",
    "vue",
    "nextjs",
    "angular",
    "typescript",
    "javascript",
    "frontend",
    "webdev",
    "antigravity",
    "cursor"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgb23/funky-theme"
  },
  "bugs": {
    "url": "https://github.com/maxgb23/funky-theme/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies"
  },
  "contributes": {
    "themes": [
      {
        "label": "Funky Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark.json"
      },
      {
        "label": "Funky Darker",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-darker.json"
      },
      {
        "label": "Funky Dark Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark-italic.json"
      },
      {
        "label": "Funky Dark Mix",
        "uiTheme": "vs-dark",
        "path": "./themes/maxiano-dark-mix.json"
      },
      {
        "label": "Funky High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/maxiano-high-contrast.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "json5": "^2.2.3"
  },
  "pnpm": {}
}